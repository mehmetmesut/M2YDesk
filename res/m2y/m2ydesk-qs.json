{
  "app-name": "M2YDeskQS",
  "conn-type": "incoming",
  "disable-settings": "Y",
  "disable-account": "Y",
  "disable-ab": "Y",
  "disable-installation": "Y",
  "override-settings": {
    "custom-rendezvous-server": "${M2Y_SERVER_HOST}",
    "relay-server": "${M2Y_SERVER_HOST}",
    "key": "${M2Y_SERVER_KEY}",
    "register-device": "N",
    "allow-auto-update": "N",
    "enable-check-update": "N",
    "verification-method": "use-temporary-password",
    "temporary-password-length": "6",
    "allow-remote-config-modification": "N",
    "hide-help-cards": "Y",
    "hide-powered-by-me": "Y",
    "hide-server-settings": "Y",
    "hide-network-settings": "Y",
    "hide-proxy-settings": "Y",
    "hide-security-settings": "Y"
  },
  "default-settings": {
    "lang": "tr"
  }
}
