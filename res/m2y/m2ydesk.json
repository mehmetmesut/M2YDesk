{
  "app-name": "M2YDesk",
  "m2y-whatsapp": "905307302002",
  "override-settings": {
    "custom-rendezvous-server": "${M2Y_SERVER_HOST}",
    "relay-server": "${M2Y_SERVER_HOST}",
    "key": "${M2Y_SERVER_KEY}",
    "api-server": "https://${M2Y_SERVER_HOST}",
    "m2y-report-device": "Y",
    "allow-auto-update": "Y",
    "enable-check-update": "Y",
    "hide-server-settings": "Y",
    "hide-powered-by-me": "Y",
    "m2y-nonmember-limit": "N",
    "m2y-require-auth": "Y"
  },
  "default-settings": {
    "lang": "tr",
    "view-style": "adaptive",
    "scroll-style": "scrollauto",
    "image-quality": "best",
    "codec-preference": "auto",
    "show-monitors-toolbar": "Y",
    "collapse-toolbar": "Y",
    "show-remote-cursor": "Y",
    "follow-remote-cursor": "Y",
    "follow-remote-window": "Y",
    "enable-file-copy-paste": "Y",
    "terminal-persistent": "Y"
  }
}
