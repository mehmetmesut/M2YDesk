# RustDesk sunucu ayarları
# Kullanım: cp .env.example .env  (kurulum.sh bunu otomatik yapar)

# İstemcilerin bağlanacağı alan adı (Plesk DNS'inde sunucu IP'sine A kaydı olmalı)
ALAN_ADI=desk.mehmetmesut.com

# Docker imaj sürümü - üretimde sabit sürüm önerilir (örn. 1.1.14)
# Güncel sürümler: https://github.com/rustdesk/rustdesk-server/releases
RUSTDESK_SURUM=latest

# Log zaman damgaları için saat dilimi
TZ=Europe/Istanbul

# Hesap API sunucusu imaj sürümü (üretimde sabit sürüm önerilir)
API_SURUM=latest
