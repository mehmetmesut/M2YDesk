# rustdesk.mehmetmesut.com - indirme sayfası Apache ayarları (Plesk)

# HTTPS'e yönlendir
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# İstemci dosyaları tarayıcıda açılmadan doğrudan indirilsin
<FilesMatch "\.(exe|dmg|deb|AppImage|apk)$">
    ForceType application/octet-stream
    Header set Content-Disposition attachment
    Header set X-Content-Type-Options nosniff
</FilesMatch>

# Dizin listelemeyi kapat
Options -Indexes

# Temel güvenlik başlıkları
Header always set X-Frame-Options "DENY"
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Büyük dosyalar sıkıştırılmasın (zaten sıkıştırılmış)
SetEnvIfNoCase Request_URI "\.(exe|dmg|deb|AppImage|apk)$" no-gzip
