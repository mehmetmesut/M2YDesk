# Plesk → Web siteleri ve alan adları → desk.mehmetmesut.com → Apache ve nginx Ayarları
# → "Ek nginx yönergeleri" kutusuna yapıştırın (HTTPS için). Sonra "Tamam".
# Gerekli: docker compose --profile api up -d  (API 127.0.0.1:21114'te dinler)

location ^~ /api/ {
    proxy_pass http://127.0.0.1:21114;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Yönetim paneli: yalnızca kendi IP adresinize izin verin (aşağıdaki IP'yi değiştirin) ya da bu bloğu kaldırın.
location ^~ /_admin/ {
    # allow 203.0.113.10;
    # deny all;
    proxy_pass http://127.0.0.1:21114;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
