# Plesk ek nginx yönergeleri. Sunucuda uygulanan hali: /var/www/vhosts/system/desk.mehmetmesut.com/conf/vhost_nginx.conf
# (Plesk 18.0.80 CLI bu alanı ayarlayamıyor; dosya yazılıp: /usr/local/psa/admin/bin/httpdmng --reconfigure-domain desk.mehmetmesut.com)
# Yönetim paneli /yonetici/ altında, yalnızca izinli IP'lere (ev/iş) açık. IP değişirse buradan güncelleyin.

# M2YDesk hesap API'si (m2y-api, 127.0.0.1:21114)
location ^~ /api/ {
    proxy_pass http://127.0.0.1:21114;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
}

# Yönetim paneli: /yonetici/ (panel arayüzü göreli yol kullanır, API çağrıları /api/admin'e gider)
location ^~ /yonetici/ {
    allow 88.232.174.141;
    allow 185.33.62.141;
    deny all;
    proxy_pass http://127.0.0.1:21114/_admin/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "same-origin" always;
}
location = /yonetici {
    return 301 /yonetici/;
}

# Eski adres kalıcı olarak yeni adrese
location ^~ /_admin/ {
    return 301 /yonetici/;
}
location = /_admin {
    return 301 /yonetici/;
}

# Kurulum betikleri (Windows PowerShell / macOS): UTF-8 olarak sunulur; aksi hâlde PowerShell 5.1
# Türkçe karakterleri bozar.
location ~ ^/(win-kur\.ps1|mac-kur\.sh)$ {
    types { }
    default_type "text/plain; charset=utf-8";
    add_header Cache-Control "no-cache" always;
    add_header X-Content-Type-Options "nosniff" always;
}
